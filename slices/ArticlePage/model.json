{
  "id": "use_case_detail",
  "type": "SharedSlice",
  "name": "ArticlePage",
  "description": "A detailed use case content section with heading, rich text descriptions, and multiple CTA buttons",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "description": "Default variation with heading, content, and CTAs",
      "version": "initial",
      "docURL": "...",
      "imageUrl": "",
      "primary": {
        "heading": {
          "type": "StructuredText",
          "config": {
            "label": "Heading",
            "single": "heading1",
            "placeholder": "Where Voice Agents Work"
          }
        },
        "content": {
          "type": "StructuredText",
          "config": {
            "label": "Content",
            "placeholder": "Describe the use case",
            "allowTargetBlank": true,
            "multi": "paragraph,strong,em,hyperlink,heading3,heading2,list-item,o-list-item,image"
          }
        },
        "prevArticle": {
          "type": "Link",
          "config": {
            "label": "Prev article",
            "placeholder": "",
            "allowText": true,
            "select": "web"
          }
        },
        "nextArticle": {
          "type": "Link",
          "config": {
            "label": "Next article",
            "placeholder": "",
            "allowText": true,
            "select": "web"
          }
        },
        "calloutBlock": {
          "type": "StructuredText",
          "config": {
            "label": "CalloutBlock",
            "placeholder": "",
            "allowTargetBlank": true,
            "multi": "paragraph,preformatted,heading3,heading4,heading5,heading6,strong,em,hyperlink,embed,list-item,o-list-item,rtl"
          }
        },
        "worksheetTitle": {
          "type": "Text",
          "config": {
            "label": "Worksheet Title"
          }
        },
        "worksheetCta": {
          "type": "Link",
          "config": {
            "label": "Worksheet CTA",
            "allowText": true,
            "select": "web"
          }
        },
        "ctacards": {
          "type": "Group",
          "config": {
            "label": "CtaCards",
            "repeat": true,
            "fields": {
              "title": {
                "type": "Text",
                "config": {
                  "label": "Title",
                  "placeholder": "CTA Title"
                }
              },
              "cta_description": {
                "type": "Text",
                "config": {
                  "label": "CTA Description",
                  "placeholder": "CTA Description"
                }
              },
              "cta_link": {
                "type": "Link",
                "config": {
                  "label": "CTA Link",
                  "placeholder": "CTA Link",
                  "select": null,
                  "allowTargetBlank": true,
                  "allowText": true,
                  "repeat": false
                }
              }
            }
          }
        }
      },
      "items": {}
    }
  ]
}