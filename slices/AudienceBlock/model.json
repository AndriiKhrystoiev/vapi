{
  "id": "audience_grid",
  "type": "SharedSlice",
  "name": "AudienceBlock",
  "description": "A grid section displaying multiple audience cards with titles, descriptions, and related chapters.",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "",
      "version": "initial",
      "description": "Default variation with audience grid layout",
      "imageUrl": "",
      "primary": {
        "label": {
          "type": "Text",
          "config": {
            "label": "Label",
            "placeholder": "e.g., AUDIENCE"
          }
        },
        "heading": {
          "type": "StructuredText",
          "config": {
            "label": "Heading",
            "single": "heading2",
            "placeholder": "e.g., Who this playbook is for."
          }
        },
        "cards": {
          "type": "Group",
          "config": {
            "label": "Audience Cards",
            "fields": {
              "title": {
                "type": "StructuredText",
                "config": {
                  "label": "Card Title",
                  "single": "heading3"
                }
              },
              "description": {
                "type": "StructuredText",
                "config": {
                  "label": "Card Description",
                  "single": "paragraph"
                }
              },
              "chapters_info": {
                "type": "Text",
                "config": {
                  "label": "Chapters Info",
                  "placeholder": "e.g., Chapters 5-8, 21, 28-29"
                }
              },
              "chapters_list": {
                "type": "Group",
                "config": {
                  "label": "Chapters List",
                  "fields": {
                    "chapter_number": {
                      "type": "Text",
                      "config": {
                        "label": "Chapter Number",
                        "placeholder": "e.g., Ch 5"
                      }
                    },
                    "chapter_link": {
                      "type": "Link",
                      "config": {
                        "label": "Chapter link",
                        "placeholder": "",
                        "select": null,
                        "allowTargetBlank": true,
                        "allowText": true,
                        "repeat": false
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "items": {}
    }
  ]
}