{
  "id": "guide_playbook_hero",
  "type": "SharedSlice",
  "name": "Home",
  "description": "Hero section for a comprehensive guide/playbook with table of contents, learning outcomes, and audience information",
  "variations": [
    {
      "id": "default",
      "name": "HomePage",
      "docURL": "",
      "version": "initial",
      "description": "Default variation",
      "imageUrl": "",
      "primary": {
        "heading": {
          "type": "StructuredText",
          "config": {
            "label": "Heading",
            "single": "heading1",
            "placeholder": "Enter main heading"
          }
        },
        "description": {
          "type": "StructuredText",
          "config": {
            "label": "Description",
            "single": "paragraph",
            "placeholder": "Enter description"
          }
        },
        "cta_button": {
          "type": "Link",
          "config": {
            "label": "CTA Button",
            "placeholder": "",
            "allowText": true,
            "select": null,
            "variants": [
              "Primary",
              "Secondary"
            ]
          }
        },
        "newsletter_button": {
          "type": "Link",
          "config": {
            "label": "Newsletter button",
            "placeholder": "",
            "select": null,
            "allowTargetBlank": true,
            "allowText": true,
            "repeat": false,
            "variants": [
              "Primary",
              "Secondary"
            ]
          }
        },
        "learning_section_heading": {
          "type": "Text",
          "config": {
            "label": "Learning Section Heading",
            "placeholder": "e.g., What you'll learn"
          }
        },
        "learning_outcomes": {
          "type": "Group",
          "config": {
            "label": "Learning Outcomes",
            "fields": {
              "outcome_heading": {
                "type": "Text",
                "config": {
                  "label": "Outcome Heading",
                  "placeholder": ""
                }
              },
              "outcome_text": {
                "type": "StructuredText",
                "config": {
                  "label": "Outcome Text",
                  "single": "paragraph"
                }
              },
              "outcome_image": {
                "type": "Image",
                "config": {
                  "label": "Outcome Image",
                  "constraint": {},
                  "thumbnails": []
                }
              }
            }
          }
        }
      },
      "items": {}
    }
  ]
}