{
  "id": "guide_roadmap",
  "type": "SharedSlice",
  "name": "HomePage",
  "description": "A comprehensive guide roadmap with title, subtitle, CTA buttons, and multiple numbered parts containing collapsible sections with subsection items",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "",
      "version": "initial",
      "description": "Default variation",
      "imageUrl": "",
      "primary": {
        "title": {
          "type": "StructuredText",
          "config": {
            "label": "Title",
            "single": "heading1",
            "placeholder": "Enter title"
          }
        },
        "subtitle": {
          "type": "StructuredText",
          "config": {
            "label": "Subtitle",
            "single": "paragraph",
            "placeholder": "Enter subtitle"
          }
        },
        "cta_buttons": {
          "type": "Link",
          "config": {
            "label": "CTA Buttons",
            "allowText": true,
            "repeat": true,
            "variants": ["Primary", "Secondary"],
            "select": null
          }
        },
        "parts": {
          "type": "Group",
          "config": {
            "label": "Roadmap Parts",
            "fields": {
              "part_number": {
                "type": "Number",
                "config": {
                  "label": "Part Number"
                }
              },
              "part_title": {
                "type": "Text",
                "config": {
                  "label": "Part Title",
                  "placeholder": "e.g., Strategy"
                }
              },
              "sections": {
                "type": "Group",
                "config": {
                  "label": "Sections",
                  "fields": {
                    "section_title": {
                      "type": "Text",
                      "config": {
                        "label": "Section Title",
                        "placeholder": "Enter section title"
                      }
                    },
                    "section_description": {
                      "type": "StructuredText",
                      "config": {
                        "label": "Section Description",
                        "multi": "paragraph,strong,em,hyperlink",
                        "placeholder": "Enter description"
                      }
                    },
                    "expanded": {
                      "type": "Boolean",
                      "config": {
                        "label": "Expanded by default"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "items": {}
    }
  ]
}
